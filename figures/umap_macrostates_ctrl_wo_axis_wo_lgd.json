{
    "infile": "data/rna/ctrl/trajectories/macrostates/adata.h5ad",
    "outfile": "figures/results/umap_macrostates_ctrl_wo_axis_wo_lgd",
    "modules": [
        {"numpy": "np"},
        {"anndatatools": "adt"}
    ],
    "eval": [
        "colors",
        "xlabel",
        "ylabel",
        "zlabel",
        "n_components"
    ],
    "figure": {
        "obs": "macrostates",
        "obsm": "X_umap",
        "figheight": 5,
        "figwidth": 6,
        "xlabel": "r'$\\mathrm{UMAP_{1}}$'",
        "ylabel": "r'$\\mathrm{UMAP_{2}}$'",
        "zlabel": "r'$\\mathrm{UMAP_{3}}$'",
        "colors": "adt.pl.color.COLORS",
        "s": 2,
        "alpha": 1,
        "add_legend": false,
        "n_components": "2 if adata.obsm['X_umap'].shape[1] == 2 else 3",
        "background_visible": false
    },
    "grid": false,
    "axis": "off"
}
