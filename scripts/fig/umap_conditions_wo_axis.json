{
    "infile": "apl/counts/integrated/clustering/clusters/counts.h5ad",
    "outfile": "fig/results/umap_conditions_wo_axis.pdf",
    "modules": [
        {"numpy": "np"},
        {"bonesistools": "bt"}
    ],
    "eval": [
        "colors",
        "xlabel",
        "ylabel",
        "zlabel",
        ["legend", "edgecolor"],
        "n_components"
    ],
    "figure": {
        "obs": "condition",
        "representation": "X_umap",
        "figheight": 5,
        "figwidth": 6,
        "xlabel": "r'$\\mathrm{UMAP_{1}}$'",
        "ylabel": "r'$\\mathrm{UMAP_{2}}$'",
        "zlabel": "r'$\\mathrm{UMAP_{3}}$'",
        "colors": "bt.sct.pl.CLASSIC_COLORS",
        "legend": {
            "title": "conditions",
            "loc":"best",
            "ncol": 1,
            "markerscale": 5,
            "frameon": true,
            "edgecolor": "bt.sct.pl.get_color('black')",
            "shadow": false
        },
        "text": {
            "fontsize": 12,
            "fontweight": "extra bold"
        },
        "n_components": "2 if adata.obsm['X_umap'].shape[1] == 2 else 3",
        "background_visible": false
    },
    "grid": false,
    "axis": "off"
}
