{
    "modules": [
        {"numpy": "np"},
        {"bonesistools": "bt"},
        "math"
    ],
    "eval": [
        "xlabel",
        "ylabel",
        "zlabel",
        ["legend", "title"],
        ["legend", "edgecolor"]
    ],
    "figure": {
        "obs": "pct_bin",
        "figwidth": 6,
        "xlabel": "r'$\\mathrm{dim_{1}}$'",
        "ylabel": "r'$\\mathrm{dim_{2}}$'",
        "zlabel": "r'$\\mathrm{dim_{3}}$'",
        "s": 3,
        "legend": {
            "title": "r'$\\% \\mathrm{bin}$'",
            "ncol": 1,
            "markerscale": 5,
            "frameon": true,
            "edgecolor": "bt.sct.pl.get_color('black')",
            "shadow": false
        },
        "background_visible": false
    },
    "grid": false,
    "axis": "off"
}
