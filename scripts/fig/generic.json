{
    "modules": [
        {"numpy": "np"},
        {"bonesistools": "bt"}
    ],
    "eval": [
        "xlabel",
        "ylabel",
        "zlabel",
        ["lgd_params", "edgecolor"]
    ],
    "figure": {
        "figheight": 5,
        "figwidth": 6,
        "xlabel": "r'$\\mathrm{dim_{1}}$'",
        "ylabel": "r'$\\mathrm{dim_{2}}$'",
        "zlabel": "r'$\\mathrm{dim_{3}}$'",
        "show_legend": true,
        "s": 2,
        "alpha": 1,
        "lgd_params": {
            "ncol": 1,
            "markerscale": 5,
            "frameon": true,
            "edgecolor": "bt.sct.pl.get_color('black')",
            "shadow": false
        },
        "text": {
            "fontsize": 12,
            "fontweight": "extra bold"
        },
        "background_visible": false
    }
}
