{
    "modules": [
        {"numpy": "np"},
        {"bonesistools": "bt"},
        "math"
    ],
    "eval": [
        "xlabel",
        "ylabel",
        "zlabel",
        "colors",
        ["lgd_params", "edgecolor"]
    ],
    "figure": {
        "obs": "pypairs_cc_prediction",
        "figwidth": 6,
        "xlabel": "r'$\\mathrm{dim_{1}}$'",
        "ylabel": "r'$\\mathrm{dim_{2}}$'",
        "zlabel": "r'$\\mathrm{dim_{3}}$'",
        "s": 3,
        "alpha": 1,
        "colors": "[sct.pl.get_color('blue'), sct.pl.get_color('red'), sct.pl.get_color('green')]",
        "show_legend": true,
        "lgd_params": {
            "title": "cell cycle",
            "ncol": 1,
            "markerscale": 8,
            "frameon": true,
            "edgecolor": "bt.sct.pl.get_color('black')",
            "shadow": false
        },
        "automatic_resize": true,
        "background_visible": false
    },
    "grid": false,
    "axis": "off"
}
