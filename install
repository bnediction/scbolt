#!/usr/bin/env bash

set -e

scbolt_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
env_dir="${scbolt_root}/envs/conda"
lib_dir="${scbolt_root}/lib"
scbolt_command="${scbolt_root}/bin/scbolt"
scbolt_completion="${scbolt_root}/bin/completion.bash"
local_bin="${HOME}/.local/bin"
local_completion_dir="${HOME}/.local/share/bash-completion/completions"
local_config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/scbolt"
backend_config="${local_config_dir}/config.mk"
default_image="ghcr.io/bnediction/scbolt:latest"
scbolt_envs=(
    system
    align
    bonesis
    cellrank
    core
    cotan
    fastq
    potency
    scboolseq
    stream
    velocity
    velocyto
)

assume_yes=false
install_cli=false
install_completions=false
install_all=false
target_requested=false
backend="conda"
backend_requested=false
selected_envs=()
ignored_envs=()

usage() {
    local install_command="${SCBOLT_INSTALL_COMMAND:-./install}"

    if [ -n "${SCBOLT_INSTALL_COMMAND:-}" ]; then
        cat <<EOF
usage: ${install_command} [BACKEND] [--all] [--completions] [--env=NAME]

Install a scBOLT runtime backend or repair Bash completion.

Without options, install all runtime environments interactively.

Options
  --all                  install all runtime environments without prompts
  --completions          reinstall Bash completion only
  --env=NAME             install one environment; can be repeated
  --backend=BACKEND      runtime backend: conda, mamba, micromamba, or docker
  --help, -h             display this help

Environment names
  ${scbolt_envs[*]}
EOF
        return
    fi

    cat <<EOF
usage: ${install_command} [--all] [--completions] [--env=NAME] [--backend=conda|mamba|micromamba|docker]

Install the scBOLT command, Bash completion, and selected runtime environments.

Without options, install the scBOLT command and Bash completion.

Options
  --all                  install CLI and all runtime environments without prompts
  --completions          reinstall Bash completion only
  --env=NAME             install one conda environment; can be repeated
  --backend=BACKEND      runtime backend: conda, mamba, micromamba, or docker
  --help, -h             display this help

Environment names
  ${scbolt_envs[*]}
EOF
}

is_known_env() {
    local query="$1"
    local env

    for env in "${scbolt_envs[@]}"
    do
        if [ "${env}" = "${query}" ];
        then
            return 0
        fi
    done
    return 1
}

append_selected_env() {
    local env="$1"

    if [ -z "${env}" ];
    then
        printf 'missing value for --env\n' >&2
        usage >&2
        exit 2
    fi

    if ! is_known_env "${env}";
    then
        ignored_envs+=("${env}")
        return 0
    fi

    selected_envs+=("${env}")
}

deduplicate_selected_envs() {
    local env
    local deduplicated_envs=()
    local seen_envs=""

    for env in "$@"
    do
        case " ${seen_envs} " in
            *" ${env} "*) ;;
            *)
                deduplicated_envs+=("${env}")
                seen_envs="${seen_envs} ${env}"
                ;;
        esac
    done

    selected_envs=("${deduplicated_envs[@]}")
}

select_all_envs() {
    selected_envs=("${scbolt_envs[@]}")
}

set_backend() {
    case "$1" in
        conda|mamba|micromamba|docker)
            backend="$1"
            backend_requested=true
            ;;
        "")
            printf 'missing value for --backend\n' >&2
            usage >&2
            exit 2
            ;;
        *)
            printf 'unsupported backend: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
}

while [ "$#" -gt 0 ];
do
    case "$1" in
        --all)
            if [ "${target_requested}" = true ];
            then
                printf '%s\n' "use either --all or explicit targets, not both" >&2
                usage >&2
                exit 2
            fi
            install_all=true
            ;;
        --cli)
            if [ "${install_all}" = true ];
            then
                printf '%s\n' "use either --all or explicit targets, not both" >&2
                usage >&2
                exit 2
            fi
            install_cli=true
            target_requested=true
            ;;
        --completions)
            if [ "${install_all}" = true ];
            then
                printf '%s\n' "use either --all or explicit targets, not both" >&2
                usage >&2
                exit 2
            fi
            install_completions=true
            target_requested=true
            ;;
        --env=*)
            if [ "${install_all}" = true ];
            then
                printf '%s\n' "use either --all or explicit targets, not both" >&2
                usage >&2
                exit 2
            fi
            append_selected_env "${1#--env=}"
            target_requested=true
            ;;
        --env)
            if [ "${install_all}" = true ];
            then
                printf '%s\n' "use either --all or explicit targets, not both" >&2
                usage >&2
                exit 2
            fi
            shift
            if [ "$#" -eq 0 ];
            then
                printf 'missing value for --env\n' >&2
                usage >&2
                exit 2
            fi
            append_selected_env "$1"
            target_requested=true
            ;;
        --backend=*)
            set_backend "${1#--backend=}"
            ;;
        --backend)
            shift
            if [ "$#" -eq 0 ];
            then
                printf 'missing value for --backend\n' >&2
                usage >&2
                exit 2
            fi
            set_backend "$1"
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'unsupported option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [ "${install_all}" = true ];
then
    if [ -z "${SCBOLT_INSTALL_COMMAND:-}" ]; then
        install_cli=true
    fi
    select_all_envs
    assume_yes=true
elif [ "${target_requested}" = true ];
then
    assume_yes=true
else
    if [ -z "${SCBOLT_INSTALL_COMMAND:-}" ]; then
        install_cli=true
        assume_yes=true
        if [ "${backend_requested}" = true ]; then
            select_all_envs
            assume_yes=false
        fi
    else
        select_all_envs
    fi
fi

deduplicate_selected_envs "${selected_envs[@]}"

is_yes_enabled() {
    case "${assume_yes}" in
        true|yes|y|1) return 0 ;;
        *) return 1 ;;
    esac
}

prompt_backend() {
    local choice

    if [ "${#selected_envs[@]}" -eq 0 ] || [ "${backend_requested}" = true ] || [ ! -t 0 ];
    then
        return 0
    fi

    if is_yes_enabled && [ "${install_all}" != true ];
    then
        return 0
    fi

    printf '%s\n' "Select the environment backend to install scBOLT environments:"
    printf '%s\n' "  1) conda"
    printf '%s\n' "  2) mamba"
    printf '%s\n' "  3) micromamba"
    printf '%s\n' "  4) docker"
    read -r -p $"Backend ([1]/2/3/4): " choice

    case "${choice}" in
        ""|1|conda)
            backend="conda"
            ;;
        2|mamba)
            backend="mamba"
            ;;
        3|micromamba)
            backend="micromamba"
            ;;
        4|docker)
            backend="docker"
            ;;
        *)
            printf 'unsupported backend: %s\n' "${choice}" >&2
            exit 2
            ;;
    esac

    echo
}

prompt_backend

if [ -t 1 ];
then
    stdout_green=$'\033[0;32m'
    stdout_yellow=$'\033[0;33m'
    stdout_nc=$'\033[0m'
else
    stdout_green=""
    stdout_yellow=""
    stdout_nc=""
fi

if [ -t 2 ];
then
    stderr_red=$'\033[0;31m'
    stderr_nc=$'\033[0m'
else
    stderr_red=""
    stderr_nc=""
fi

print_install_success() {
    printf '%s✓%s %s successfully installed.\n' "${stdout_green}" "${stdout_nc}" "$1"
}

print_install_warning() {
    printf '%s⚠%s %s not reinstalled.\n' "${stdout_yellow}" "${stdout_nc}" "$1"
}

print_warning() {
    printf '%s⚠%s %s\n' "${stdout_yellow}" "${stdout_nc}" "$1"
}

print_install_failure() {
    printf '%s✗%s %s failed to install.\n' "${stderr_red}" "${stderr_nc}" "$1" >&2
}

print_backend_failure() {
    printf '%s✗%s %s backend failed to initialize.\n' "${stderr_red}" "${stderr_nc}" "${backend}" >&2
}

install_backend_config() {
    mkdir -p "${local_config_dir}"
    {
        printf '%s\n' "# scBOLT user configuration."
        printf 'BACKEND = %s\n' "${backend}"
        if [ "${backend}" = "docker" ]; then
            printf 'SCBOLT_IMAGE = %s\n' "${default_image}"
        fi
    } > "${backend_config}"
    echo "Installed configuration:"
    echo "  ${backend_config}"
}

install_docker_backend() {
    local docker_command

    docker_command="$(command -v docker 2>/dev/null || true)"
    if [ -z "${docker_command}" ]; then
        print_backend_failure
        printf '%s\n' "command not found: docker" >&2
        return 1
    fi

    install_backend_config
    if ! docker image inspect "${default_image}" >/dev/null 2>&1; then
        echo "pulling Docker image '${default_image}'."
        docker pull "${default_image}" || return_or_interrupt "$?"
    fi
    print_install_success "docker backend"
}

env_backend_command() {
    command -v "${backend}" 2>/dev/null || true
}

env_tool() {
    case "${backend}" in
        micromamba)
            if [ -n "${MAMBA_ROOT_PREFIX:-}" ];
            then
                MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX}" "${env_command}" "$@"
            else
                "${env_command}" "$@"
            fi
            ;;
        *)
            "${env_command}" "$@"
            ;;
    esac
}

env_run() {
    local env="$1"
    shift

    case "${backend}" in
        conda)
            env_tool run --no-capture-output -n "${env}" "$@"
            ;;
        mamba|micromamba)
            env_tool run -n "${env}" "$@"
            ;;
    esac
}

for env_suffix in "${ignored_envs[@]}"
do
    print_warning "unsupported environment ignored: ${env_suffix}"
done

handle_interrupt() {
    trap - INT TERM
    echo >&2
    printf '%s✗%s installation canceled by user.\n' "${stderr_red}" "${stderr_nc}" >&2
    exit 130
}

trap handle_interrupt INT TERM

handle_interrupt_status() {
    local status="$1"

    if [ "${status}" -ge 128 ];
    then
        handle_interrupt
    fi
}

return_or_interrupt() {
    local status="$1"

    handle_interrupt_status "${status}"

    return "${status}"
}

run_quiet() {
    local logfile
    local status

    logfile=$(mktemp)
    if "$@" >"${logfile}" 2>&1;
    then
        rm -f "${logfile}"
        return 0
    fi

    status=$?
    if [ "${status}" -ge 128 ];
    then
        rm -f "${logfile}"
        handle_interrupt
    fi

    cat "${logfile}" >&2
    rm -f "${logfile}"
    return_or_interrupt "${status}"
}

develop_scbolt_lib() {
    if [ "$1" == "scbolt-align" ] || [ "$1" == "scbolt-system" ];
    then
        return 0
    fi

    run_quiet env_run "$1" python -c '
import sysconfig
import sys
from pathlib import Path

lib_dir = Path(sys.argv[1]).resolve()
site_packages = Path(sysconfig.get_path("purelib"))
pth_file = site_packages / "scbolt-lib.pth"
pth_file.write_text(f"{lib_dir}\n", encoding="utf-8")
' "${lib_dir}"
}

configure_env() {
    develop_scbolt_lib "$1" || return_or_interrupt "$?"
}

install_env_steps() {
    local env="$1"
    local env_file="$2"

    echo "creating ${backend} environment '${env}'."
    echo "resolving ${backend} environment '${env}'."
    run_quiet env_tool env create -f "${env_file}" --yes || return_or_interrupt "$?"
    load_installed_envs || return_or_interrupt "$?"
    if ! env_exists "${env}";
    then
        printf '%s\n' "${backend} environment '${env}' was not created." >&2
        return 1
    fi
    configure_env "${env}" || return_or_interrupt "$?"
}

install_env() {
    local choice
    local status

    if env_exists "$1";
    then
        echo "${backend} environment '$1' already exists."
        if is_yes_enabled;
        then
            choice="y"
        else
            read -r -p $"Do you want to reinstall ${backend} environment '${1}'? ([y]/n): " choice
        fi
        if [[ $choice == "y" || -z $choice ]];
        then
            echo "removing ${backend} environment '$1'."
            if run_quiet env_tool remove --name "$1" --all --yes && load_installed_envs && ! env_exists "$1" && install_env_steps "$1" "$2";
            then
                installed_envs["$1"]=1
                print_install_success "$1"
                echo
            else
                status=$?
                handle_interrupt_status "${status}"
                print_install_failure "$1"
                return 1
            fi

        else
            print_install_warning "$1"
            echo
        fi
    else
        if install_env_steps "$1" "$2";
        then
            installed_envs["$1"]=1
            print_install_success "$1"
            echo
        else
            status=$?
            handle_interrupt_status "${status}"
            print_install_failure "$1"
            return 1
        fi
    fi
}

install_scbolt_command() {
    local choice
    local installed_command="${local_bin}/scbolt"

    if [ ! -x "${scbolt_command}" ];
    then
        echo "scBOLT command not found: ${scbolt_command}"
        return 1
    fi

    if is_yes_enabled;
    then
        choice="y"
    else
        read -r -p $"Install the scbolt command in ~/.local/bin? ([y]/n): " choice
    fi
    if [[ $choice != "y" && $choice != "Y" && $choice != "yes" && -n $choice ]];
    then
        if [ -e "${installed_command}" ];
        then
            echo "scBOLT command unchanged:"
            echo "  ${installed_command}"
        else
            echo "scBOLT command not installed."
        fi
        return 1
    fi

    mkdir -p "${local_bin}"
    ln -sfn "${scbolt_command}" "${installed_command}"

    echo "Installed:"
    echo "  ${installed_command} -> ${scbolt_command}"

    case ":${PATH}:" in
        *":${local_bin}:"*) ;;
        *)
            echo
            echo "Add this line to your shell configuration:"
            echo
            # shellcheck disable=SC2016
            echo 'export PATH="$HOME/.local/bin:$PATH"'
            ;;
    esac

    return 0
}

install_scbolt_completion() {
    if [ ! -f "${scbolt_completion}" ];
    then
        echo "scBOLT Bash completion not found: ${scbolt_completion}"
        return
    fi

    mkdir -p "${local_completion_dir}"
    ln -sfn "${scbolt_completion}" "${local_completion_dir}/scbolt"

    echo "Installed Bash completion:"
    echo "  ${local_completion_dir}/scbolt -> ${scbolt_completion}"
    echo
    echo "Restart your shell, or run:"
    echo
    echo "  source ${local_completion_dir}/scbolt"
}

declare -A installed_envs

load_installed_envs() {
    local env_line
    local env_list
    local env_name
    local env_prefix
    local field

    installed_envs=()

    if ! env_list="$(env_tool env list 2>/dev/null)";
    then
        print_backend_failure
        printf '%s\n' "could not list ${backend} environments from: ${env_command}" >&2
        return 1
    fi

    while IFS= read -r env_line
    do
        set -- ${env_line}
        [ "$#" -gt 0 ] || continue

        env_name="$1"
        case "${env_name}" in
            "#"|"Name"|"-"*|"─"*)
                continue
                ;;
        esac

        env_prefix=
        for field in "$@"
        do
            env_prefix="${field}"
        done

        [ -d "${env_prefix}/conda-meta" ] || continue
        case "${env_name}" in
            /*|.*)
                env_name="${env_prefix##*/}"
                ;;
        esac
        installed_envs["${env_name}"]=1
    done <<< "${env_list}"
}

env_exists() {
    [ -n "${installed_envs[$1]+x}" ]
}

if [ "${install_cli}" = true ];
then
    if install_scbolt_command;
    then
        install_scbolt_completion
    fi
    echo
fi

if [ "${install_completions}" = true ];
then
    install_scbolt_completion
    echo
fi

if [ "${#selected_envs[@]}" -eq 0 ];
then
    if [ "${backend_requested}" = true ];
    then
        install_backend_config
    fi
    exit 0
fi

if [ "${backend}" = "docker" ];
then
    if install_docker_backend;
    then
        if [ "${#selected_envs[@]}" -gt 0 ];
        then
            print_warning "Docker image contains prebuilt scBOLT environments; local --env selections were ignored."
        fi
        echo
        exit 0
    fi
    exit 1
fi

env_command="$(env_backend_command)"
if [ -z "${env_command}" ];
then
    print_backend_failure
    printf '%s\n' "command not found: ${backend}" >&2
    exit 1
fi

install_backend_config

if [ "${backend}" = "conda" ];
then
    conda_base="$(env_tool info --base 2>/dev/null)" || {
        print_backend_failure
        printf '%s\n' "failed to run: conda info --base" >&2
        printf '%s\n' "resolved conda command: ${env_command}" >&2
        exit 1
    }
    conda_profile="${conda_base}/etc/profile.d/conda.sh"
    if [ ! -f "${conda_profile}" ];
    then
        print_backend_failure
        printf '%s\n' "missing conda activation script: ${conda_profile}" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "${conda_profile}"
fi

load_installed_envs || exit 1

if [ "${backend}" = "conda" ] && env_exists base;
then
    conda activate base
fi

for env_suffix in "${selected_envs[@]}"
do
    file="${env_dir}/${env_suffix}.yml"
    env="scbolt-${env_suffix}"
    if [ ! -f "${file}" ];
    then
        print_install_failure "${env}"
        printf '%s\n' "missing environment file: ${file}" >&2
        exit 1
    fi
    install_env "$env" "$file"
done
