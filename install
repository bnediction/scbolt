#!/bin/sh

set -eu

usage() {
    cat <<'EOF'
usage: ./install

Install the native scBOLT launcher for the current platform.
After installation, use 'scbolt install [backend]' to install or replace a
runtime backend.
EOF
}

case "${1-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

if [ "$#" -ne 0 ]; then
    printf 'unsupported install argument: %s\n' "$1" >&2
    usage >&2
    exit 2
fi

root=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
system=$(uname -s 2>/dev/null || printf 'unknown')
architecture=$(uname -m 2>/dev/null || printf 'unknown')

case "$system" in
    Linux*)
        case "$architecture" in
            x86_64|amd64)
                launcher="$root/dist/scbolt-linux-amd64"
                ;;
            *)
                printf 'unsupported Linux architecture: %s\n' "$architecture" >&2
                exit 1
                ;;
        esac
        ;;
    Darwin*)
        case "$architecture" in
            x86_64|amd64)
                launcher="$root/dist/scbolt-darwin-amd64"
                ;;
            arm64|aarch64)
                launcher="$root/dist/scbolt-darwin-arm64"
                ;;
            *)
                printf 'unsupported macOS architecture: %s\n' "$architecture" >&2
                exit 1
                ;;
        esac
        ;;
    MINGW*|MSYS*|CYGWIN*)
        launcher="$root/install.exe"
        ;;
    unknown)
        if [ "${OS-}" = "Windows_NT" ]; then
            launcher="$root/install.exe"
        else
            printf 'unable to detect the host platform\n' >&2
            exit 1
        fi
        ;;
    *)
        printf 'unsupported operating system: %s\n' "$system" >&2
        exit 1
        ;;
esac

if [ ! -f "$launcher" ]; then
    printf 'scBOLT launcher not found: %s\n' "$launcher" >&2
    printf 'regenerate release launchers with: make -C launcher release\n' >&2
    exit 1
fi

exec "$launcher"
