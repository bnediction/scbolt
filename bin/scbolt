#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
    local source="${BASH_SOURCE[0]}"
    local dir

    while [ -L "${source}" ]; do
        dir="$(cd -P "$(dirname "${source}")" && pwd)"
        source="$(readlink "${source}")"
        if [[ "${source}" != /* ]]; then
            source="${dir}/${source}"
        fi
    done

    dir="$(cd -P "$(dirname "${source}")" && pwd)"
    printf '%s/%s\n' "${dir}" "$(basename "${source}")"
}

SCBOLT_SCRIPT="$(resolve_script_path)"
SCBOLT_BIN_DIR="$(dirname "${SCBOLT_SCRIPT}")"
SCBOLT_ROOT="$(cd "${SCBOLT_BIN_DIR}/.." && pwd)"
SCBOLT_MAKEFILE="${SCBOLT_ROOT}/Makefile"
SCBOLT_DEFAULT_PARAMS="${SCBOLT_ROOT}/mk/default_params.mk"
SCBOLT_TOOL="${SCBOLT_BIN_DIR}/scbolt-tool"
terminal_device=""
terminal_state=""

if [ -z "${CONDA_EXE:-}" ]; then
    conda_path="$(command -v conda 2>/dev/null || true)"
    if [ -n "${conda_path}" ] && command -v readlink >/dev/null 2>&1; then
        conda_path="$(readlink -f "${conda_path}" 2>/dev/null || printf '%s' "${conda_path}")"
    fi
    if [ -n "${conda_path}" ] && [ -x "${conda_path}" ]; then
        export CONDA_EXE="${conda_path}"
    fi
fi

command -v awk >/dev/null 2>&1 || awk() { "${SCBOLT_TOOL}" awk "$@"; }
command -v cat >/dev/null 2>&1 || cat() { "${SCBOLT_TOOL}" cat "$@"; }
command -v grep >/dev/null 2>&1 || grep() { "${SCBOLT_TOOL}" grep "$@"; }
command -v head >/dev/null 2>&1 || head() { "${SCBOLT_TOOL}" head "$@"; }
command -v sed >/dev/null 2>&1 || sed() { "${SCBOLT_TOOL}" sed "$@"; }
command -v tee >/dev/null 2>&1 || tee() { "${SCBOLT_TOOL}" tee "$@"; }

restore_terminal() {
    if [ -n "${terminal_state}" ] && [ -n "${terminal_device}" ]; then
        stty "${terminal_state}" < "${terminal_device}" 2> /dev/null || true
    fi
}

hide_control_characters() {
    if terminal_state="$( { stty -g < /dev/tty; } 2> /dev/null )"; then
        terminal_device="/dev/tty"
    elif [ -t 0 ]; then
        terminal_device="/dev/stdin"
        terminal_state="$(stty -g < "${terminal_device}" 2> /dev/null || true)"
    else
        return 0
    fi

    if [ -z "${terminal_state}" ]; then
        return 0
    fi

    stty -echoctl < "${terminal_device}" 2> /dev/null || true
    trap restore_terminal EXIT
}

hide_control_characters

if [ -t 1 ]; then
    stdout_green=$'\033[0;32m'
    stdout_yellow=$'\033[0;33m'
    stdout_bold=$'\033[1m'
    stdout_nc=$'\033[0m'
else
    stdout_green=""
    stdout_yellow=""
    stdout_bold=""
    stdout_nc=""
fi

if [ -t 2 ]; then
    stderr_red=$'\033[0;31m'
    stderr_nc=$'\033[0m'
else
    stderr_red=""
    stderr_nc=""
fi

print_success() {
    printf '%s%s%s %s\n' "${stdout_green}" "✓" "${stdout_nc}" "$1"
}

print_warning() {
    printf '%s%s%s %s\n' "${stdout_yellow}" "⚠" "${stdout_nc}" "$1"
}

print_error() {
    printf '%s%s%s %s\n' "${stderr_red}" "✗" "${stderr_nc}" "$1" >&2
}

print_success_status() {
    printf '%s%s Completed:%s %s\n' "${stdout_green}" "✓" "${stdout_nc}" "$1"
}

print_warning_status() {
    printf '%s%s %s:%s %s\n' "${stdout_yellow}" "⚠" "$1" "${stdout_nc}" "$2"
}

print_failure_status() {
    printf '%s%s Failed:%s %s\n' "${stderr_red}" "✗" "${stderr_nc}" "$1" >&2
}

print_installation_error() {
    local missing_file="$1"

    print_error "scBOLT installation is incomplete or corrupted: ${missing_file} not found."
    printf '%s\n' "Expected: ${SCBOLT_ROOT}/${missing_file}" >&2
    printf '%s\n' "Please reinstall scBOLT or rerun config.sh." >&2
}

if [ ! -f "${SCBOLT_MAKEFILE}" ]; then
    print_installation_error "Makefile"
    exit 1
fi

if [ ! -f "${SCBOLT_DEFAULT_PARAMS}" ]; then
    print_installation_error "mk/default_params.mk"
    exit 1
fi

usage() {
    local params_arg

    params_arg="$(optional_params_make_arg || true)"
    if [ -n "${params_arg}" ]; then
        make -f "${SCBOLT_MAKEFILE}" help SCBOLT_CLI=true "${params_arg}"
    else
        make -f "${SCBOLT_MAKEFILE}" help SCBOLT_CLI=true
    fi
    exit "$?"
}

init_help() {
    printf '%s\n\n' "usage: scbolt init [<params.mk>] [options]"
    printf '%s\n\n' "Create, update, or remove the project configuration used by scBOLT."
    printf '%sParameters%s\n' "${stdout_bold}" "${stdout_nc}"
    printf '  %-31s %s\n' '<params.mk>' 'parameter file to use'
    printf '  %-31s %s\n' '--remove' 'remove active project configuration'
    printf '  %-31s %s\n' '--show' 'display active parameter file'
    printf '  %-31s %s\n' '--<parameter>=<value>' 'initialize a new parameter file'
    printf '  %-31s %s\n' '<parameter>=<value>' 'initialize a new parameter file'
    printf '  %-31s %s\n' '--help' 'display this help'
}

trim() {
    local value="$1"

    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s\n' "${value}"
}

absolute_path() {
    local path="$1"
    local dir
    local base

    dir="$(dirname "${path}")"
    base="$(basename "${path}")"
    printf '%s/%s\n' "$(cd "${dir}" && pwd)" "${base}"
}

find_project_file() {
    local dir="${PWD}"

    while true; do
        if [ -f "${dir}/.scbolt" ]; then
            printf '%s\n' "${dir}/.scbolt"
            return 0
        fi
        if [ "${dir}" = "/" ]; then
            return 1
        fi
        dir="$(dirname "${dir}")"
    done
}

read_project_params() {
    local project_file="$1"
    local line
    local value

    while IFS= read -r line || [ -n "${line}" ]; do
        line="$(trim "${line}")"
        case "${line}" in
            ""|\#*) continue ;;
        esac
        if [[ "${line}" =~ ^PARAMS[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            value="$(trim "${BASH_REMATCH[1]}")"
        else
            value="${line}"
        fi
        if [ -z "${value}" ]; then
            return 1
        fi
        printf '%s\n' "${value}"
        return 0
    done < "${project_file}"

    return 1
}

resolve_project_params() {
    local project_file
    local project_dir
    local params

    if project_file="$(find_project_file)"; then
        project_dir="$(dirname "${project_file}")"
        params="$(read_project_params "${project_file}")" || {
            print_error "Invalid .scbolt project file: ${project_file}"
            exit 1
        }
        if [[ "${params}" = /* ]]; then
            printf '%s\n' "${params}"
        else
            printf '%s\n' "$(absolute_path "${project_dir}/${params}")"
        fi
        return 0
    fi

    if [ -f "${PWD}/params.mk" ]; then
        printf '%s\n' "params.mk"
        return 0
    fi

    return 1
}

optional_params_make_arg() {
    local params
    local params_path

    params="$(resolve_project_params)" || return 0
    if [[ "${params}" = /* ]]; then
        params_path="${params}"
    else
        params_path="${PWD}/${params}"
    fi
    if [ -f "${params_path}" ]; then
        printf 'PARAMS=%s\n' "${params}"
    fi
}

require_params_file() {
    local params="$1"
    local failure_message="${2:-}"
    local params_path

    if [ -z "${params}" ]; then
        if [ -n "${failure_message}" ]; then
            printf '%s\n' "No parameter file found." >&2
            print_error "${failure_message}"
        else
            print_error "No parameter file found."
        fi
        printf '\n' >&2
        printf '%s\n' "Run:" >&2
        printf '  %s\n' "scbolt init <params.mk>" >&2
        printf '%s\n' "or:" >&2
        printf '  %s\n' "scbolt <target> --params=<file>" >&2
        exit 1
    fi

    if [[ "${params}" = /* ]]; then
        params_path="${params}"
    else
        params_path="${PWD}/${params}"
    fi

    if [ ! -f "${params_path}" ]; then
        if [ -n "${failure_message}" ]; then
            printf '%s\n' "Parameter file not found: ${params}" >&2
            print_error "${failure_message}"
        else
            print_error "Parameter file not found: ${params}"
        fi
        exit 1
    fi

    case "${params}" in
        *.mk) ;;
        *)
            if [ -n "${failure_message}" ]; then
                printf '%s\n' "Parameter file must have a .mk extension: ${params}" >&2
                print_error "${failure_message}"
            else
                print_error "Parameter file must have a .mk extension: ${params}"
            fi
            exit 1
            ;;
    esac
}

default_init_params() {
    if [ -f "${PWD}/params.mk" ]; then
        printf '%s\n' "params.mk"
    fi
    return 0
}

init_override_names=()
init_override_values=()

normalize_init_variable() {
    local variable="$1"

    variable="${variable#--}"
    variable="${variable//-/_}"
    variable="${variable^^}"
    case "${variable}" in
        ""|*[!A-Z0-9_]*|[0-9]*)
            print_error "Invalid parameter name: ${variable}"
            exit 1
            ;;
    esac
    printf '%s\n' "${variable}"
}

add_init_override() {
    local variable="$1"
    local value="$2"

    variable="$(normalize_init_variable "${variable}")"
    init_override_names+=("${variable}")
    init_override_values+=("${value}")
}

init_override_value() {
    local variable="$1"
    local default_value="$2"
    local index

    for index in "${!init_override_names[@]}"; do
        if [ "${init_override_names[${index}]}" = "${variable}" ]; then
            default_value="${init_override_values[${index}]}"
        fi
    done
    printf '%s\n' "${default_value}"
}

format_init_assignment() {
    local variable="$1"
    local default_value="$2"
    local value

    value="$(init_override_value "${variable}" "${default_value}")"
    if [ -n "${value}" ]; then
        printf '%s = %s\n' "${variable}" "${value}"
    else
        printf '%s =\n' "${variable}"
    fi
}

is_minimal_params_variable() {
    case "$1" in
        ORGANISM|CONDITIONS|SRA|GSM|SRA_*|GSM_*|COUNT_FILES|MACROSTATE_FILES|\
BINARIZATION_FILE|LABEL|SPEC_FILE)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

is_init_project_setting() {
    case "$1" in
        ORGANISM|CONDITIONS|PROJECT_DIR|RESOURCES_DIR|MEMORY|JOBS|SEED|LOGGING)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

is_init_input_source() {
    case "$1" in
        SRA|SRA_*|GSM|GSM_*|COUNT_FILES|MACROSTATE_FILES|BINARIZATION_FILE|OLD_FILES)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

init_override_section() {
    if is_init_project_setting "$1"; then
        printf '%s\n' "project"
    elif is_init_input_source "$1"; then
        printf '%s\n' "input"
    else
        printf '%s\n' "module"
    fi
}

write_init_condition_source_assignments() {
    local family="$1"
    local conditions
    local condition
    local variable

    conditions="$(init_override_value CONDITIONS "")"
    if [ -z "${conditions}" ]; then
        format_init_assignment "${family}" ""
        return 0
    fi

    for condition in ${conditions}; do
        variable="${family}_${condition^^}"
        format_init_assignment "${variable}" ""
    done
}

write_init_overrides() {
    local section="$1"
    local index
    local later_index
    local variable
    local value
    local skip
    local wrote=false

    for index in "${!init_override_names[@]}"; do
        variable="${init_override_names[${index}]}"
        value="${init_override_values[${index}]}"
        skip=false
        for later_index in "${!init_override_names[@]}"; do
            if [ "${later_index}" -gt "${index}" ] \
                    && [ "${init_override_names[${later_index}]}" = "${variable}" ]; then
                skip=true
                break
            fi
        done
        if [ "${skip}" = "true" ]; then
            continue
        fi

        if is_minimal_params_variable "${variable}"; then
            continue
        fi

        if [ "$(init_override_section "${variable}")" != "${section}" ]; then
            continue
        fi

        if [ "${wrote}" = "false" ]; then
            printf '\n'
            wrote=true
        fi

        printf '%s = %s\n' "${variable}" "${value}"
    done
}

write_init_project_settings() {
    cat <<'EOF'
########################
### Project settings ###
########################

# Organism used for gene resources (e.g. mouse or human).
EOF
    format_init_assignment ORGANISM ""
    printf '\n'

    cat <<'EOF'
# Experimental conditions (e.g. ctrl treated).
# Leave empty for an unlabeled single-condition project.
EOF
    format_init_assignment CONDITIONS ""
    write_init_overrides project
    printf '\n'
}

write_init_input_sources() {
    cat <<'EOF'
#####################
### Input sources ###
#####################

# Input sources are mutually exclusive. Use one family:
# - SRA or SRA_<CONDITION>   : list of SRA run IDs
# - GSM or GSM_<CONDITION>   : GEO sample ID
# - COUNT_FILES              : precomputed count AnnData files
# - MACROSTATE_FILES         : precomputed macrostate files
# - BINARIZATION_FILE        : precomputed binarization file

# SRA = SRR12345678 SRR87654321
# SRA_CTRL = SRR12345678
# SRA_TREATED = SRR87654321 SRR87654322
EOF
    write_init_condition_source_assignments SRA
    printf '\n'

    cat <<'EOF'
# GSM = GSM5492245
# GSM_CTRL = GSM5492245
# GSM_TREATED = GSM5492246
EOF
    write_init_condition_source_assignments GSM
    printf '\n'

    format_init_assignment COUNT_FILES ""
    format_init_assignment MACROSTATE_FILES ""
    format_init_assignment BINARIZATION_FILE ""
    write_init_overrides input
    printf '\n'
}

write_init_module_inputs() {
    cat <<'EOF'
##############################
### Module-specific inputs ###
##############################

# Required by module 'annotation'.
# Space-separated biological labels assigned to clusters 0..n.
# Labels are matched to clusters in numerical order.
# Example: LABEL = HSC MPP LMPP GMP
EOF
    format_init_assignment LABEL ""
    printf '\n'

    cat <<'EOF'
# Required by module 'spec'.
# YAML file defining Boolean-network constraints.
# See case studies for examples or run: scbolt spec help
EOF
    format_init_assignment SPEC_FILE ""
    write_init_overrides module
}

write_minimal_params_file() {
    local params_path="$1"

    {
        write_init_project_settings
        write_init_input_sources
        write_init_module_inputs
    } > "${params_path}"
}

ensure_init_params_file() {
    local params="$1"
    local failure_message="$2"
    local params_path
    local params_dir

    if [[ "${params}" = /* ]]; then
        params_path="${params}"
    else
        params_path="${PWD}/${params}"
    fi

    if [ -f "${params_path}" ]; then
        case "${params}" in
            *.mk) ;;
            *)
                printf '%s\n' "Parameter file must have a .mk extension: ${params}" >&2
                print_error "${failure_message}"
                exit 1
                ;;
        esac
        return 0
    fi

    case "${params}" in
        *.mk) ;;
        *)
            printf '%s\n' "Parameter file not found: ${params}" >&2
            print_error "${failure_message}"
            exit 1
            ;;
    esac

    params_dir="$(dirname "${params_path}")"
    if [ ! -d "${params_dir}" ]; then
        printf '%s\n' "Parameter file directory not found: $(dirname "${params}")" >&2
        print_error "${failure_message}"
        exit 1
    fi

    write_minimal_params_file "${params_path}"
}

read_prompt_value() {
    local variable="$1"
    local prompt="$2"
    local value=""

    if [ -t 0 ]; then
        IFS= read -e -r -p "${prompt}" value || value=""
    else
        printf '%s' "${prompt}" >&2
        IFS= read -r value || value=""
        printf '\n' >&2
    fi
    value="$(trim "${value}")"
    printf -v "${variable}" '%s' "${value}"
}

stored_params_path() {
    local params="$1"
    local params_abs

    if [[ "${params}" != /* ]]; then
        printf '%s\n' "${params}"
        return 0
    fi

    params_abs="$(absolute_path "${params}")"
    if command -v realpath >/dev/null 2>&1; then
        realpath --relative-to="${PWD}" "${params_abs}" 2>/dev/null || printf '%s\n' "${params_abs}"
    else
        printf '%s\n' "${params_abs}"
    fi
}

init_project() {
    local params="${1:-}"
    local default_params
    local failure_message
    local params_abs
    local params_created=false
    local previous_params=""
    local stored_params

    if [ "$#" -gt 1 ]; then
        print_error "Usage: scbolt init <params.mk>"
        exit 1
    fi

    if [ -f "${PWD}/.scbolt" ]; then
        previous_params="$(read_project_params "${PWD}/.scbolt" || true)"
    fi
    if [ -n "${previous_params}" ]; then
        failure_message="scBOLT project update failed."
    else
        failure_message="scBOLT project initialization failed."
    fi

    if [ -z "${params}" ]; then
        default_params="${previous_params:-$(default_init_params)}"
        if [ -n "${default_params}" ]; then
            read_prompt_value params "Select parameter file [${default_params}]: "
            params="${params:-${default_params}}"
        else
            read_prompt_value params "Select parameter file: "
        fi
    fi
    if [ -z "${params}" ]; then
        printf '%s\n' "No parameter file specified." >&2
        print_error "${failure_message}"
        exit 1
    fi

    params_abs="$(absolute_path "${params}")"
    if [ ! -f "${params_abs}" ]; then
        params_created=true
    elif [ "${#init_override_names[@]}" -gt 0 ]; then
        print_warning "Parameter initializers ignored: parameter file already exists."
    fi

    ensure_init_params_file "${params}" "${failure_message}"
    require_params_file "${params}" "${failure_message}"
    stored_params="$(stored_params_path "${params}")"
    printf 'PARAMS=%s\n' "${stored_params}" > "${PWD}/.scbolt"

    if [ -n "${previous_params}" ]; then
        if [ "${previous_params}" = "${stored_params}" ]; then
            if [ "${params_created}" = "true" ]; then
                printf '%s %s (created)\n' "Parameter file:" "${stored_params}"
                print_success "scBOLT project updated."
            else
                printf '%s %s\n' "Parameter file:" "${stored_params}"
                print_warning "scBOLT project unchanged."
            fi
        else
            if [ "${params_created}" = "true" ]; then
                printf '%s %s -> %s (created)\n' \
                    "Parameter file:" "${previous_params}" "${stored_params}"
            else
                printf '%s %s -> %s\n' \
                    "Parameter file:" "${previous_params}" "${stored_params}"
            fi
            print_success "scBOLT project updated."
        fi
    else
        if [ "${params_created}" = "true" ]; then
            printf '%s %s (created)\n' "Parameter file:" "${stored_params}"
        else
            printf '%s %s\n' "Parameter file:" "${stored_params}"
        fi
        print_success "scBOLT project initialized."
    fi
}

remove_project() {
    local project_file
    local params=""

    if ! project_file="$(find_project_file)"; then
        printf '%s\n' "Project file not found."
        print_warning "scBOLT project unchanged."
        return 0
    fi

    params="$(read_project_params "${project_file}" || true)"
    printf '%s %s\n' "Project file:" "${project_file}"
    if [ -n "${params}" ]; then
        printf '%s %s\n' "Parameter file:" "${params}"
    fi

    if rm -f "${project_file}"; then
        print_success "scBOLT project configuration removed."
    else
        print_error "scBOLT project removal failed."
        exit 1
    fi
}

show_project_params() {
    local params

    if ! params="$(resolve_project_params)"; then
        print_error "No parameter file found."
        exit 1
    fi

    printf '%s %s\n' "Parameter file:" "${params}"
}

option_to_make_variable() {
    local option="$1"
    local variable

    variable="${option#--}"
    variable="${variable//-/_}"
    printf '%s\n' "${variable^^}"
}

collect_global_args() {
    leading_args=()

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --params|--references|--reset-target|--trust-target|--old-file|--logging|--target)
                if [ "$#" -eq 1 ]; then
                    print_error "Missing value for $1"
                    exit 1
                fi
                leading_args+=("$1" "$2")
                shift 2
                ;;
            --raw)
                leading_args+=("$1")
                shift
                ;;
            --raw=*)
                print_error "Unsupported scbolt option with value: --raw"
                printf '%s\n' "Use '--raw' without a value." >&2
                exit 1
                ;;
            --level|--level=*)
                print_error "Unsupported scbolt option: --level"
                printf '%s\n' "Use '--raw' to display the raw config listing." >&2
                exit 1
                ;;
            --*=*|*=*)
                leading_args+=("$1")
                shift
                ;;
            --*)
                print_error "Unsupported scbolt option without value: $1"
                printf '%s\n' "Use '$1=<value>' or a supported command option." >&2
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    remaining_args=("$@")
}

translate_args() {
    local arg
    local option
    local value
    local project_file

    make_args=()
    positional_args=()
    params_from_cli=""
    params_from_make=""

    while [ "$#" -gt 0 ]; do
        arg="$1"
        shift

        case "${arg}" in
            --params=*)
                params_from_cli="${arg#--params=}"
                ;;
            --params)
                if [ "$#" -eq 0 ]; then
                    print_error "Missing value for --params"
                    exit 1
                fi
                params_from_cli="$1"
                shift
                ;;
            --references=*)
                make_args+=("REFERENCES=${arg#--references=}")
                ;;
            --references)
                if [ "$#" -eq 0 ]; then
                    print_error "Missing value for --references"
                    exit 1
                fi
                make_args+=("REFERENCES=$1")
                shift
                ;;
            --reset-target=*)
                make_args+=("CLI_RESET_TARGETS+=${arg#--reset-target=}")
                ;;
            --reset-target)
                if [ "$#" -eq 0 ]; then
                    print_error "Missing value for --reset-target"
                    exit 1
                fi
                make_args+=("CLI_RESET_TARGETS+=$1")
                shift
                ;;
            --trust-target=*)
                make_args+=("CLI_TRUST_TARGETS+=${arg#--trust-target=}")
                ;;
            --trust-target)
                if [ "$#" -eq 0 ]; then
                    print_error "Missing value for --trust-target"
                    exit 1
                fi
                make_args+=("CLI_TRUST_TARGETS+=$1")
                shift
                ;;
            --old-file=*)
                make_args+=("CLI_OLD_FILES+=${arg#--old-file=}")
                ;;
            --old-file)
                if [ "$#" -eq 0 ]; then
                    print_error "Missing value for --old-file"
                    exit 1
                fi
                make_args+=("CLI_OLD_FILES+=$1")
                shift
                ;;
            --logging=*)
                make_args+=("LOGGING=${arg#--logging=}")
                ;;
            --logging)
                if [ "$#" -eq 0 ]; then
                    print_error "Missing value for --logging"
                    exit 1
                fi
                make_args+=("LOGGING=$1")
                shift
                ;;
            --raw)
                make_args+=("CONFIG_RAW=true")
                ;;
            --raw=*)
                print_error "Unsupported scbolt option with value: --raw"
                printf '%s\n' "Use '--raw' without a value." >&2
                exit 1
                ;;
            --level|--level=*)
                print_error "Unsupported scbolt option: --level"
                printf '%s\n' "Use '--raw' to display the raw config listing." >&2
                exit 1
                ;;
            --target=*)
                make_args+=("TARGET=${arg#--target=}")
                ;;
            --target)
                if [ "$#" -eq 0 ]; then
                    print_error "Missing value for --target"
                    exit 1
                fi
                make_args+=("TARGET=$1")
                shift
                ;;
            RESET_TARGET=*|reset_target=*)
                make_args+=("RESET_TARGET=${arg#*=}")
                ;;
            TRUST_TARGET=*|trust_target=*)
                make_args+=("TRUST_TARGET=${arg#*=}")
                ;;
            OLD_FILES=*|old_files=*)
                make_args+=("OLD_FILES=${arg#*=}")
                ;;
            OLD_FILE=*|old_file=*)
                make_args+=("CLI_OLD_FILES+=${arg#*=}")
                ;;
            --*=*)
                option="${arg%%=*}"
                value="${arg#*=}"
                make_args+=("$(option_to_make_variable "${option}")=${value}")
                ;;
            PARAMS=*)
                params_from_make="${arg#PARAMS=}"
                ;;
            *=*)
                make_args+=("${arg}")
                ;;
            --*)
                print_error "Unsupported scbolt option without value: ${arg}"
                printf '%s\n' "Use '${arg}=<value>' or a supported command option." >&2
                exit 1
                ;;
            *)
                positional_args+=("${arg}")
                ;;
        esac
    done

    value="${params_from_cli:-${params_from_make:-}}"
    if [ -z "${value}" ]; then
        value="$(resolve_project_params)" || true
    fi
    params_assignment="${value}"

    if project_file="$(find_project_file)"; then
        export SCBOLT_PROJECT_ROOT
        SCBOLT_PROJECT_ROOT="$(dirname "${project_file}")"
    fi
}

run_make_with_params() {
    local params="$1"
    shift

    require_params_file "${params}"
    make -f "${SCBOLT_MAKEFILE}" "$@" "PARAMS=${params}"
    exit "$?"
}

run_make_build_with_params() {
    local params="$1"
    local target_label="$2"
    local stdout_file
    local stderr_file
    local status=0
    local final_status
    local interrupted=0
    local recipe_ran=false
    local stale_warning=false
    shift 2

    require_params_file "${params}"
    stdout_file="$(mktemp)"
    stderr_file="$(mktemp)"
    trap 'interrupted=1' INT TERM
    set +e
    make -f "${SCBOLT_MAKEFILE}" "$@" "PARAMS=${params}" \
        > >(tee "${stdout_file}") \
        2> >(tee "${stderr_file}" | grep -vE '^make(\[[0-9]+\])?: \*\*\*' >&2 || true)
    status=$?
    set -e
    trap - INT TERM

    if grep -q ' - RULE - ' "${stdout_file}"; then
        recipe_ran=true
    fi
    if grep -qE ' - WARNING - (stale|untracked|missing module metadata)' "${stdout_file}"; then
        stale_warning=true
    fi
    final_status="${status}"
    if [ "${interrupted}" -eq 1 ]; then
        final_status=130
    elif grep -qE 'Error 130($|[^0-9])|KeyboardInterrupt|(^|[^[:alpha:]])Interrupt($|[^[:alpha:]])' \
            "${stderr_file}"; then
        final_status=130
    elif grep -qE 'Error 143($|[^0-9])' "${stderr_file}"; then
        final_status=143
    elif grep -qE 'Error 124($|[^0-9])|user-defined time limit reached|timed out|timeout' \
            "${stderr_file}"; then
        final_status=124
    fi
    rm -f "${stdout_file}" "${stderr_file}"

    case "${final_status}" in
        0)
            if [ "${recipe_ran}" = "true" ]; then
                print_success_status "${target_label}"
            elif [ "${stale_warning}" = "true" ]; then
                print_warning_status "Already built" "${target_label}"
            else
                print_warning_status "Up to date" "${target_label}"
            fi
            ;;
        124)
            print_warning_status "Reached time limit" "${target_label}"
            ;;
        130)
            print_warning_status "Cancelled by user" "${target_label}"
            ;;
        143)
            print_warning_status "Cancelled by user" "${target_label}"
            ;;
        *)
            print_failure_status "${target_label}"
            ;;
    esac

    exit "${status}"
}

normalize_references() {
    local value="$1"

    value="${value//+/ }"
    value="$(trim "${value}")"
    printf '%s\n' "${value}" | awk '{$1=$1; print}'
}

format_references() {
    local value="$1"

    normalize_references "${value}" | awk '{
        for (i = 1; i <= NF; i++) {
            printf "%s%s", (i == 1 ? "" : ", "), $i
        }
        printf "\n"
    }'
}

target_label_with_references() {
    local params="$1"
    local label="$2"
    local context
    local references
    local references_default
    local normalized_references
    local normalized_default
    local formatted_references
    shift 2

    context="$(make -f "${SCBOLT_MAKEFILE}" __reference-context "$@" "PARAMS=${params}" 2> /dev/null)" || {
        printf '%s\n' "${label}"
        return 0
    }

    references="$(printf '%s\n' "${context}" | sed -n 's/^REFERENCES=//p' | head -n 1)"
    references_default="$(printf '%s\n' "${context}" | sed -n 's/^REFERENCES_DEFAULT=//p' | head -n 1)"
    normalized_references="$(normalize_references "${references}")"
    normalized_default="$(normalize_references "${references_default}")"

    if [ -n "${normalized_references}" ] \
        && [ -n "${normalized_default}" ] \
        && [ "${normalized_references}" != "${normalized_default}" ]; then
        formatted_references="$(format_references "${references}")"
        printf '%s (%s)\n' "${label}" "${formatted_references}"
        return 0
    fi

    printf '%s\n' "${label}"
}

run_make_check_with_params() {
    local params="$1"
    local stderr_file
    local status=0
    shift

    require_params_file "${params}"
    stderr_file="$(mktemp)"
    set +e
    make -f "${SCBOLT_MAKEFILE}" check "$@" "PARAMS=${params}" 2> "${stderr_file}"
    status=$?
    set -e
    grep -vE '^make(\[[0-9]+\])?: \*\*\*' "${stderr_file}" >&2 || true
    rm -f "${stderr_file}"
    exit "${status}"
}

run_make_help() {
    local command="$1"
    local params_arg

    params_arg="$(optional_params_make_arg || true)"
    if [ -n "${params_arg}" ]; then
        make -f "${SCBOLT_MAKEFILE}" "${command}" HELP=true SCBOLT_CLI=true "${params_arg}"
    else
        make -f "${SCBOLT_MAKEFILE}" "${command}" HELP=true SCBOLT_CLI=true
    fi
    exit "$?"
}

has_target_assignment() {
    local arg
    local value

    for arg in "$@"; do
        case "${arg}" in
            TARGET=*)
                value="${arg#TARGET=}"
                if [ -n "${value}" ]; then
                    return 0
                fi
                ;;
        esac
    done

    return 1
}

require_module_argument() {
    local command="$1"

    print_error "Missing module for scbolt ${command}."
    printf '%s\n' "Usage: scbolt ${command} <module>" >&2
    printf '%s\n' "Run 'scbolt ${command} --help' for details." >&2
    exit 1
}

has_help_request() {
    local arg

    for arg in "$@"; do
        case "${arg}" in
            help|-h|--help|HELP=true)
                return 0
                ;;
        esac
    done

    return 1
}

drop_help_args() {
    filtered_args=()

    for arg in "$@"; do
        case "${arg}" in
            help|-h|--help|HELP=true)
                ;;
            *)
                filtered_args+=("${arg}")
                ;;
        esac
    done
}

if [ "$#" -eq 0 ]; then
    usage
fi

case "$1" in
    -h|--help|help)
        usage
        ;;
esac

collect_global_args "$@"
if [ "${#remaining_args[@]}" -eq 0 ]; then
    usage
fi

cmd="${remaining_args[0]}"
set -- "${remaining_args[@]:1}"

case "${cmd}" in
    macrostate)
        cmd="macrostates"
        ;;
esac

case "${cmd}" in
    ""|-h|--help|help)
        usage
        ;;
    init)
        if has_help_request "$@"; then
            init_help
            exit 0
        fi
        init_remove=false
        init_show=false
        init_args=()
        init_params_file=""
        init_override_names=()
        init_override_values=()
        set -- "${leading_args[@]}" "$@"
        while [ "$#" -gt 0 ]; do
            arg="$1"
            shift
            case "${arg}" in
                --remove)
                    init_remove=true
                    ;;
                --show)
                    init_show=true
                    ;;
                --remove=*)
                    print_error "Unsupported scbolt option with value: --remove"
                    printf '%s\n' "Use '--remove' without a value." >&2
                    exit 1
                    ;;
                --show=*)
                    print_error "Unsupported scbolt option with value: --show"
                    printf '%s\n' "Use '--show' without a value." >&2
                    exit 1
                    ;;
                --params=*)
                    init_params_file="${arg#--params=}"
                    ;;
                --params)
                    if [ "$#" -eq 0 ]; then
                        print_error "Missing value for --params"
                        exit 1
                    fi
                    init_params_file="$1"
                    shift
                    ;;
                PARAMS=*)
                    init_params_file="${arg#PARAMS=}"
                    ;;
                --references=*)
                    add_init_override REFERENCES "${arg#--references=}"
                    ;;
                --references)
                    if [ "$#" -eq 0 ]; then
                        print_error "Missing value for --references"
                        exit 1
                    fi
                    add_init_override REFERENCES "$1"
                    shift
                    ;;
                --old-file=*)
                    add_init_override OLD_FILES "${arg#--old-file=}"
                    ;;
                --old-file)
                    if [ "$#" -eq 0 ]; then
                        print_error "Missing value for ${arg}"
                        exit 1
                    fi
                    add_init_override OLD_FILES "$1"
                    shift
                    ;;
                --*=*)
                    add_init_override "${arg%%=*}" "${arg#*=}"
                    ;;
                --*)
                    print_error "Unsupported scbolt init option without value: ${arg}"
                    printf '%s\n' "Use '${arg}=<value>' or a supported init option." >&2
                    exit 1
                    ;;
                *=*)
                    add_init_override "${arg%%=*}" "${arg#*=}"
                    ;;
                *)
                    init_args+=("${arg}")
                    ;;
            esac
        done
        if [ -n "${init_params_file}" ]; then
            if [ "${#init_args[@]}" -gt 0 ]; then
                print_error "Use either '--params=<file>' or a positional parameter file, not both."
                exit 1
            fi
            init_args=("${init_params_file}")
        fi
        if [ "${init_remove}" = "true" ] && [ "${init_show}" = "true" ]; then
            print_error "Use either '--remove' or '--show', not both."
            exit 1
        elif [ "${init_remove}" = "true" ] && [ "${#init_args[@]}" -gt 0 ]; then
            print_error "Use either '--remove' or a parameter file, not both."
            exit 1
        elif [ "${init_show}" = "true" ] && [ "${#init_args[@]}" -gt 0 ]; then
            print_error "Use either '--show' or a parameter file, not both."
            exit 1
        elif [ "${init_remove}" = "true" ] && [ "${#init_override_names[@]}" -gt 0 ]; then
            print_error "Use parameter initializers only when creating a parameter file."
            exit 1
        elif [ "${init_show}" = "true" ] && [ "${#init_override_names[@]}" -gt 0 ]; then
            print_error "Use parameter initializers only when creating a parameter file."
            exit 1
        elif [ "${init_remove}" = "true" ]; then
            remove_project
        elif [ "${init_show}" = "true" ]; then
            show_project_params
        else
            init_project "${init_args[@]}"
        fi
        ;;
    clean)
        if has_help_request "$@"; then
            run_make_help "clean"
        fi
        clean_all=false
        clean_stale=false
        clean_force=false
        clean_args=()
        for arg in "$@"; do
            case "${arg}" in
                --all)
                    clean_all=true
                    ;;
                --stale)
                    clean_stale=true
                    ;;
                --force)
                    clean_force=true
                    ;;
                --all=*)
                    print_error "Unsupported scbolt option with value: --all"
                    printf '%s\n' "Use '--all' without a value." >&2
                    exit 1
                    ;;
                --stale=*)
                    print_error "Unsupported scbolt option with value: --stale"
                    printf '%s\n' "Use '--stale' without a value." >&2
                    exit 1
                    ;;
                --force=*)
                    print_error "Unsupported scbolt option with value: --force"
                    printf '%s\n' "Use '--force' without a value." >&2
                    exit 1
                    ;;
                *)
                    clean_args+=("${arg}")
                    ;;
            esac
        done
        translate_args "${leading_args[@]}" "${clean_args[@]}"
        if [ "${clean_all}" = "true" ] && [ "${#positional_args[@]}" -gt 0 ]; then
            print_error "Use either '--all' or explicit modules, not both."
            exit 1
        elif [ "${clean_all}" = "true" ]; then
            make_args+=("CLEAN_TARGET=all")
        elif [ "${clean_stale}" = "true" ]; then
            make_args+=("CLEAN_STALE=true")
            if [ "${#positional_args[@]}" -gt 0 ]; then
                make_args+=("CLEAN_TARGET=${positional_args[*]}")
            fi
        elif [ "${#positional_args[@]}" -gt 0 ]; then
            make_args+=("CLEAN_TARGET=${positional_args[*]}")
        fi
        if [ "${clean_force}" = "true" ]; then
            make_args+=("CLEAN_FORCE=true")
        fi
        run_make_with_params "${params_assignment}" clean "${make_args[@]}"
        ;;
    progress)
        if has_help_request "$@"; then
            run_make_help "progress"
        fi
        progress_all=false
        progress_args=()
        for arg in "$@"; do
            case "${arg}" in
                --all)
                    progress_all=true
                    ;;
                --all=*)
                    print_error "Unsupported scbolt option with value: --all"
                    printf '%s\n' "Use '--all' without a value." >&2
                    exit 1
                    ;;
                *)
                    progress_args+=("${arg}")
                    ;;
            esac
        done
        translate_args "${leading_args[@]}" "${progress_args[@]}"
        if [ "${progress_all}" = "true" ]; then
            make_args+=("PROGRESS_ALL=true")
        fi
        if [ "${#positional_args[@]}" -gt 0 ]; then
            make_args+=("TARGET=${positional_args[*]}")
        fi
        run_make_with_params "${params_assignment}" progress "${make_args[@]}"
        ;;
    check|dry-run|config)
        if has_help_request "$@"; then
            run_make_help "${cmd}"
        fi
        config_default=false
        if [ "${cmd}" = "config" ]; then
            config_args=()
            for arg in "$@"; do
                case "${arg}" in
                    --default)
                        config_default=true
                        ;;
                    --default=*)
                        print_error "Unsupported scbolt option with value: --default"
                        printf '%s\n' "Use '--default' without a value." >&2
                        exit 1
                        ;;
                    *)
                        config_args+=("${arg}")
                        ;;
                esac
            done
            set -- "${config_args[@]}"
        fi
        translate_args "${leading_args[@]}" "$@"
        make_target="${cmd}"
        if [ "${cmd}" = "dry-run" ] \
                && [ "${#positional_args[@]}" -eq 0 ] \
                && ! has_target_assignment "${make_args[@]}"; then
            require_module_argument "${cmd}"
        fi
        if [ "${cmd}" = "config" ]; then
            if [ "${#positional_args[@]}" -gt 0 ]; then
                target="${positional_args[0]}"
                positional_args=("${positional_args[@]:1}")
                make_args=("TARGET=${target}" "${positional_args[@]}" "${make_args[@]}")
            fi
            if [ "${config_default}" = "true" ]; then
                make -f "${SCBOLT_MAKEFILE}" "${make_target}" DEFAULT_CONFIG=true "${make_args[@]}"
                exit "$?"
            fi
            run_make_with_params "${params_assignment}" "${make_target}" "${make_args[@]}"
        elif [ "${cmd}" = "check" ] && [ "${#positional_args[@]}" -gt 0 ]; then
            target="${positional_args[0]}"
            positional_args=("${positional_args[@]:1}")
            run_make_check_with_params \
                "${params_assignment}" \
                "TARGET=${target}" \
                "${positional_args[@]}" \
                "${make_args[@]}"
        elif [ "${cmd}" = "check" ]; then
            run_make_check_with_params "${params_assignment}" "${make_args[@]}"
        elif [ "${#positional_args[@]}" -gt 0 ]; then
            target="${positional_args[0]}"
            positional_args=("${positional_args[@]:1}")
            run_make_with_params \
                "${params_assignment}" \
                "${make_target}" \
                "TARGET=${target}" \
                "${positional_args[@]}" \
                "${make_args[@]}"
        else
            run_make_with_params "${params_assignment}" "${make_target}" "${make_args[@]}"
        fi
        ;;
    *)
        if has_help_request "$@"; then
            drop_help_args "$@"
            translate_args "${leading_args[@]}" "${filtered_args[@]}"
            run_make_with_params \
                "${params_assignment}" \
                module-help \
                "TARGET=${cmd}" \
                "${make_args[@]}" \
                SCBOLT_CLI=true
        fi
        translate_args "${leading_args[@]}" "$@"
        module_label="${cmd}"
        if [ "${#positional_args[@]}" -gt 0 ]; then
            module_label="${module_label} ${positional_args[*]}"
        fi
        module_label="$(target_label_with_references \
            "${params_assignment}" \
            "${module_label}" \
            "${make_args[@]}")"
        run_make_build_with_params \
            "${params_assignment}" \
            "${module_label}" \
            "${cmd}" \
            "${positional_args[@]}" \
            "${make_args[@]}"
        ;;
esac
