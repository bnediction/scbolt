{
    "infile": "data/rna/integrated/clustering/clusters/integrated.h5ad",
    "outfile": "figures/results/umap_conditions_wo_axis",
    "modules": [
        {"numpy": "np"},
        {"bonesistools": "bt"}
    ],
    "eval": [
        "colors",
        "xlabel",
        "ylabel",
        "zlabel",
        ["lgd_params", "edgecolor"],
        "n_components"
    ],
    "figure": {
        "obs": "condition",
        "obsm": "X_umap",
        "figheight": 5,
        "figwidth": 6,
        "xlabel": "r'$\\mathrm{UMAP_{1}}$'",
        "ylabel": "r'$\\mathrm{UMAP_{2}}$'",
        "zlabel": "r'$\\mathrm{UMAP_{3}}$'",
        "colors": "bt.adt.pl.COLORS",
        "s": 2,
        "alpha": 1,
        "add_legend": true,
        "lgd_params": {
            "title": "conditions",
            "ncol": 1,
            "markerscale": 5,
            "frameon": true,
            "edgecolor": "bt.adt.pl.get_color('black')",
            "shadow": false
        },
        "text": {
            "fontsize": 12,
            "fontweight": "extra bold"
        },
        "n_components": "2 if adata.obsm['X_umap'].shape[1] == 2 else 3",
        "background_visible": false
    },
    "grid": false,
    "axis": "off"
}
