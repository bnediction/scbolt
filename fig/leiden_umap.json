{
    "modules": [
        {"numpy": "np"},
        {"bonesistools": "bt"}
    ],
    "eval": [
        "xlabel",
        "ylabel",
        "zlabel",
        ["lgd_params", "edgecolor"],
        "n_components"
    ],
    "figure": {
        "obs": "leiden",
        "use_rep": "X_umap",
        "figheight": 5,
        "figwidth": 6,
        "xlabel": "r'$\\mathrm{UMAP_{1}}$'",
        "ylabel": "r'$\\mathrm{UMAP_{2}}$'",
        "zlabel": "r'$\\mathrm{UMAP_{3}}$'",
        "add_legend": true,
        "s": 2,
        "alpha": 1,
        "lgd_params": {
            "title": "clusters",
            "ncol": 1,
            "markerscale": 5,
            "frameon": true,
            "edgecolor": "bt.sct.pl.get_color('black')",
            "shadow": false
        },
        "text": {
            "fontsize": 12,
            "fontweight": "extra bold"
        },
        "n_components": "3 if adata.obsm['X_umap'].shape[1] > 2 and args.plot_3d is True else 2",
        "background_visible": false
    }
}
