{
    "modules": [
        {"numpy": "np"},
        {"bonesistools": "bt"},
        "math"
    ],
    "eval": [
        "xlabel",
        "ylabel",
        "zlabel",
        ["lgd_params", "ncol"],
        ["lgd_params", "edgecolor"],
        "n_components"
    ],
    "figure": {
        "obs": "macrostates",
        "use_rep": "X_umap",
        "figheight": 6,
        "figwidth": 8,
        "xlabel": "r'$\\mathrm{UMAP_{1}}$'",
        "ylabel": "r'$\\mathrm{UMAP_{2}}$'",
        "zlabel": "r'$\\mathrm{UMAP_{3}}$'",
        "s": 4,
        "alpha": 1,
        "add_labels": true,
        "add_legend": true,
        "lgd_params": {
            "title": "macrostates",
            "ncol": "math.ceil(len(adata.obs['macrostates'].astype('category').cat.categories) / 16)",
            "markerscale": 5,
            "frameon": true,
            "edgecolor": "bt.sct.pl.get_color('black')",
            "shadow": false
        },
        "text": {
            "fontsize": 15,
            "fontweight": "extra bold"
        },
        "n_components": "2 if adata.obsm['X_umap'].shape[1] == 2 else 3",
        "automatic_resize": true,
        "background_visible": false
    },
    "grid": false,
    "axis": "off"
}
